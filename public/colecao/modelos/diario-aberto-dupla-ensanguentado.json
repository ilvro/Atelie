    {
      "id": "l-12-diario-aberto-dupla-ensanguentado",
      "name": "Página esquerda",
      "kind": "text",
      "visible": true,
      "locked": false,
      "opacity": 1,
      "blend": "normal",
      "x": 140,
      "y": 200,
      "width": 780,
      "height": 900,
      "rotation": 0,
      "clip": false,
      "light": "both",
      "text": {
        "content": "Hoje o pai voltou a descer ao porão. Ouvi a chave girar às dez e meia e os passos desceram devagar, como quem conta os degraus. Quando subiu, trazia nas botas a terra vermelha que só existe lá embaixo. A mãe não quis jantar. Eu fingi dormir, mas escutei: ele falava baixo com alguém, e ninguém respondia.",
        "font": {
          "family": "La Belle Aurore",
          "library": "casa-font-labelleaurore",
          "weight": 400,
          "italic": false
        },
        "size": 38,
