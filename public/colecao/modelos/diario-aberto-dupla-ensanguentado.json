    },
    {
      "id": "l-13-diario-aberto-dupla-ensanguentado",
      "name": "Página direita",
      "kind": "text",
      "visible": true,
      "locked": false,
      "opacity": 1,
      "blend": "normal",
      "x": 1080,
      "y": 200,
      "width": 780,
      "height": 900,
      "rotation": 0,
      "clip": false,
      "light": "both",
      "text": {
        "content": "Quinta-feira. Perguntei à Maria o que há no porão. Ela benzeu-se e disse que eu não pergunte, que a casa escuta. Esta noite as velas da sala apagaram sozinhas, todas ao mesmo tempo. Escrevo isto ao pé da janela, com a vela da cozinha, e juro que a terra vermelha chegou até a escada.",
