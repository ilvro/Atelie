{
  "name": "atelie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --outDir dist-pages --host 127.0.0.1",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "colecao:texturas": "node scripts/colecao/build.js",
    "colecao:elementos": "node scripts/colecao/build.js --elements",
    "colecao:fontes": "node scripts/colecao/build.js --fonts",
    "colecao:fontes:specimen": "node scripts/colecao/font-specimen.js",
    "colecao:modelos": "node scripts/colecao/templates.js",
    "colecao:modelo": "node scripts/colecao/model.js",
    "library:elements": "node scripts/library/import-elements.js",
    "library:psd-report": "node --max-old-space-size=8192 scripts/library/psd-report.js",
    "library:psd-import": "node --max-old-space-size=8192 scripts/library/import-psd.js",
    "library:index-bundles": "node scripts/library/index-all-bundles.js",
    "colecao:externos": "node scripts/colecao/externos/fetch.js",
    "colecao:externos:verify": "node scripts/colecao/externos/fetch.js --verify"
  },
  "dependencies": {
    "express": "4.22.1"
  },
  "devDependencies": {
    "ag-psd": "30.2.0",
    "fflate": "0.8.3",
    "playwright": "1.58.2",
    "sharp": "0.35.5",
    "vite": "7.3.6"
  }
}
